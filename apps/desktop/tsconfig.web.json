{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["./src/renderer/src/*"]
    },
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.web.tsbuildinfo"
  },
  "include": [
    "src/renderer/src/**/*",
    "src/preload/index.ts",
    "src/shared/**/*"
  ]
}
